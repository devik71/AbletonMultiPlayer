{
  "name": "abletonmp-extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist/extension.js",
  "description": "Probe-розширення: перевіряє чотири невідомих перед тим, як будувати шар поверх Extensions SDK",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:prod": "tsc --noEmit && tsx build.ts --production",
    "start": "tsx build.ts && ableton-extensions-cli run",
    "probe-server": "node probe-server.mjs",
    "package": "npm run build:prod && ableton-extensions-cli package"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "esbuild": "0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "ws": "^8.18.0",
    "@types/node": "^24.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
