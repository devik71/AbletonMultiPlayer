# Проєкт живе на двох машинах, тож нормалізація має бути одна.
# Без цього кожен файл, торкнутий на іншій машині, виглядає зміненим цілком.
* text=auto eol=lf

# Windows PowerShell 5.1 надійніше парсить CRLF; BOM у .ps1 git не чіпає
# (він потрібен, інакше кирилиця в скриптах ламає парсер)
*.ps1 text eol=crlf

# Бінарне: мерж і нормалізація тут лише зіпсують файл
*.als binary
*.alp binary
*.wav binary
*.aif binary
*.aiff binary
*.flac binary
