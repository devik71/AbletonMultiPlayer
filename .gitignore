node_modules/
__pycache__/
*.pyc
.DS_Store
**/.DS_Store

# рантайм-стан, не артефакти коду
relay/journals/
daemon/state/
*.log

# локальні секрети для AI chat / OpenAI.
# Поклади ключ в один із цих файлів, одним рядком:
#   remote-script/AbletonMP/openai_api_key
#   .abletonmp/openai_api_key
#   ~/.abletonmp/openai_api_key
.abletonmp/
.env
.env.*
*_api_key
*token*

# лог робочої сесії, не частина проєкту
conversations/

# Extensions SDK: ліцензія Ableton забороняє поширювати SDK або його частини
# поза власним застосунком, а бета-матеріали є конфіденційними.
# Кожен розробник качає zip зі свого бета-кабінету сам.
extensions-sdk-*/
extension/vendor/*.tgz
extension/dist/

# адреса relay, яку запамʼятовує start-p2.bat -- у кожного своя
.relay-address
